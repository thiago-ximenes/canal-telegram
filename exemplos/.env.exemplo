# Ou grave $CANAL_DIR/telegram.json com {"token": "...", "chat": "..."} -- assim o
# token nao aparece em `docker inspect` nem no historico do shell.
TELEGRAM_TOKEN=123456:AAE...
CANAL_DONOS=            # quem pode MANDAR (ids humanos); vazio = so o TELEGRAM_CHAT
TELEGRAM_CHAT=987654321
CANAL_DIR=/estado
CANAL_NOME=canal
CANAL_ANEXOS_NO_AGENTE=  # onde o AGENTE ve _anexos; vazio = /entrada/_anexos
